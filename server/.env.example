PORT=8787
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_KEY=replace-with-a-separate-admin-secret
# 首次启动时创建 admin 超级管理员；初始化完成后建议从生产环境变量移除
INITIAL_ADMIN_PASSWORD=replace-with-initial-admin-password
# H5 生产域名；本地开发可留空（服务默认允许 *）
CORS_ORIGIN=https://m.example.com
# 上传图片返回 URL 的公共前缀；留空时按请求 Host 生成，本地开发即可
UPLOAD_PUBLIC_BASE_URL=https://api.example.com
# 生产默认关闭，仅本地联调可显式打开
ENABLE_DEV_LOGIN=false
# 注册验证码 SMTP（QQ 邮箱示例；授权码只放服务器环境变量或后台安全配置）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@qq.com
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=月入万刀 <your@qq.com>
WECHAT_APPID=wx-your-appid
WECHAT_SECRET=your-wechat-secret
# mock 仅用于本地联调；生产使用 wechat 并配置商户参数
PAYMENT_PROVIDER=wechat
WECHAT_MCHID=your-wechat-merchant-id
WECHAT_API_KEY=your-wechat-api-v3-key
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
